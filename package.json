{
  "name": "mineradio-apple-music-edition",
  "productName": "MineRadio Apple Music Edition",
  "version": "1.2.1",
  "description": "Windows 沉浸式音乐播放器，融合桌面模式、歌词舞台、粒子视觉和 3D 歌单架。",
  "author": "Mineradio",
  "license": "GPL-3.0-only",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:win:dir": "electron-builder --win dir",
    "build:win:internal-beta": "electron-builder --config electron-builder.internal-beta.json --win nsis --publish never",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:installer": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.fhji.minradio.applemusic",
    "productName": "MineRadio Apple Music Edition",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "npmRebuild": false,
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "extraResources": [
      {
        "from": "desktop/smtc-bridge.ps1",
        "to": "smtc-bridge.ps1"
      },
      {
        "from": "desktop/smtc-audio-capture.ps1",
        "to": "smtc-audio-capture.ps1"
      },
      {
        "from": "desktop/native/MineRadioAudioCapture.exe",
        "to": "native/MineRadioAudioCapture.exe"
      }
    ],
    "files": [
      "desktop/**/*",
      "desktop/native/**/*",
      "public/**/*",
      "build/**/*",
      "cuefield/**/*",
      "server.js",
      "*-api.js",
      "qishui-auth-v6.js",
      "qishui-qr-login.js",
      "qishui-auth-v6/**/*",
      "qishui-audio-decryptor/**/*",
      "dj-analyzer.js",
      "LICENSE",
      "NOTICE.md",
      "docs/THIRD_PARTY_PORTS.md",
      "package.json",
      "!desktop/wallpaper-preload.js",
      "!public/wallpaper.html",
      "!public/index.*.html",
      "public/index.html"
    ],
    "asar": false,
    "win": {
      "executableName": "MineRadio-Apple-Music-Edition",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MineRadio Apple Music Edition",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "artifactName": "MineRadio-Apple-Music-Specially-Customized-Edition-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "MineRadio-Apple-Music-Specially-Customized-Edition-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FHJI-lgtm",
        "repo": "MineRadio-Apple-Music-Specially-Customized-Edition"
      }
    ]
  },
  "mineradio": {
    "runtimeName": "MineRadio Apple Music Edition",
    "appUserModelId": "com.fhji.minradio.applemusic",
    "update": {
      "provider": "github",
      "owner": "FHJI-lgtm",
      "repo": "MineRadio-Apple-Music-Specially-Customized-Edition",
      "preview": false,
      "preferMirrors": true,
      "mirrors": [
        "https://gh.llkk.cc/",
        "https://ghfast.top/",
        "https://gh-proxy.com/"
      ]
    }
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "mpg123-decoder": "^1.0.3",
    "music-metadata": "11.14.0",
    "NeteaseCloudMusicApi": "^4.32.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "axios": "1.18.1",
    "body-parser": "1.20.6",
    "music-metadata": "11.14.0"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2"
  }
}
